# --- Database ---
# Local dev default (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/job_application_mcp

# --- MCP server ---
APP_ENV=development
LOG_LEVEL=INFO
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer token(s) required to call the remote MCP endpoint (comma-separated).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKENS=

# --- AI provider (used only for job analysis / resume selection / cover letters) ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
