# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Production example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/job_application_mcp

# --- MCP server ---
APP_ENV=development
LOG_LEVEL=INFO
MCP_HOST=0.0.0.0
MCP_PORT=8000

# --- OAuth 2.1 / Auth0 ---
# Auth0 tenant issuer, e.g. https://your-tenant.us.auth0.com/
OAUTH_ISSUER_URL=
# Auth0 API Identifier used as the access-token audience.
OAUTH_AUDIENCE=
# Exact public MCP endpoint, e.g. https://example.com/mcp
OAUTH_RESOURCE_URL=
# Optional; defaults to OAUTH_ISSUER_URL + .well-known/jwks.json
OAUTH_JWKS_URL=
OAUTH_REQUIRED_SCOPE=mcp:access

# --- AI provider ---
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- File storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
